# Copy to bot-tokens.env, fill in values, then: chmod 600 bot-tokens.env
# Single entry point for all fleet secrets — setup-bots.sh fans these out
# into ~/.hermes/profiles/<slug>/.env (chmod 600, non-destructive).
# slug=token  (no quotes — Telegram tokens contain a colon)

# Your numeric Telegram user ID (from @userinfobot) — same for all bots.
# Without it, the bots deny every incoming message.
ALLOWED_USERS=

# --- Telegram bot tokens (BotFather /newbot, one per agent) ---
general=
research=
assistant=
ops=
writer=
coder=
producer=

# --- Model-provider API keys (docs/04 §5.8) ---
# Fanned out to ALL seven profiles. Leave empty to skip (existing values
# in profile .env files are preserved).
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# --- Web research (docs/08) — Phase B, fine to leave empty for now ---
# Fanned out to research, assistant, coder, writer only.
TINYFISH_API_KEY=
