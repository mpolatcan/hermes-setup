+    def test_external_launchd_definition_is_preserved_and_reported(
+        self, tmp_path, monkeypatch, capsys
+    ):
+        plist_path = tmp_path / "ai.hermes.gateway.plist"
+        original = """<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+<key>Label</key><string>ai.hermes.gateway</string>
+<key>HermesManagedExternally</key><true/>
+<key>ProgramArguments</key><array><string>/bin/zsh</string><string>/safe-wrapper</string></array>
+</dict></plist>
+"""
+        plist_path.write_text(original, encoding="utf-8")
+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(
+            gateway_cli,
+            "generate_launchd_plist",
+            lambda: (_ for _ in ()).throw(AssertionError("external plist must not be regenerated")),
+        )
+        monkeypatch.setattr(
+            gateway_cli.subprocess,
+            "run",
+            lambda *args, **kwargs: SimpleNamespace(
+                returncode=113, stdout="", stderr="Could not find service"
+            ),
+        )
+
+        assert gateway_cli.launchd_plist_is_current() is True
+        assert gateway_cli.refresh_launchd_plist_if_needed() is False
+        assert plist_path.read_text(encoding="utf-8") == original
+
+        gateway_cli.launchd_status()
+        output = capsys.readouterr().out.lower()
+        assert "externally managed" in output
+        assert "stale" not in output
+
+    def test_valid_binary_external_launchd_definition_is_preserved(
+        self, tmp_path, monkeypatch
+    ):
+        plist_path = tmp_path / "ai.hermes.gateway.plist"
+        original = plistlib.dumps(
+            {
+                "Label": gateway_cli.get_launchd_label(),
+                "HermesManagedExternally": True,
+                "ProgramArguments": ["/bin/zsh", "/safe-wrapper"],
+            },
+            fmt=plistlib.FMT_BINARY,
+        )
+        plist_path.write_bytes(original)
+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(
+            gateway_cli,
+            "generate_launchd_plist",
+            lambda: (_ for _ in ()).throw(AssertionError("valid external binary plist must not be regenerated")),
+        )
+
+        assert gateway_cli.launchd_plist_is_current() is True
+        assert gateway_cli.refresh_launchd_plist_if_needed() is False
+        assert plist_path.read_bytes() == original
+
+    def test_external_launchd_definition_survives_normal_install_and_start(
+        self, tmp_path, monkeypatch, capsys
+    ):
+        plist_path = tmp_path / "ai.hermes.gateway.plist"
+        original = (
+            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+            "<plist version=\"1.0\"><dict>"
+            f"<key>Label</key><string>{gateway_cli.get_launchd_label()}</string>"
+            "<key>HermesManagedExternally</key><true/>"
+            "<key>ProgramArguments</key><array>"
+            "<string>/bin/zsh</string><string>/safe-wrapper</string>"
+            "</array></dict></plist>"
+        )
+        plist_path.write_text(original, encoding="utf-8")
+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(
+            gateway_cli,
+            "generate_launchd_plist",
+            lambda: (_ for _ in ()).throw(AssertionError("normal lifecycle must preserve external plist")),
+        )
+        calls = []
+        monkeypatch.setattr(
+            gateway_cli.subprocess,
+            "run",
+            lambda cmd, **kwargs: calls.append(cmd)
+            or SimpleNamespace(returncode=0, stdout="", stderr=""),
+        )
+
+        gateway_cli.launchd_install()
+        gateway_cli.launchd_start()
+
+        assert plist_path.read_text(encoding="utf-8") == original
+        service_mutations = [
+            cmd for cmd in calls if "kickstart" in cmd or "bootout" in cmd or "bootstrap" in cmd
+        ]
+        assert service_mutations == [
+            [
+                "launchctl",
+                "kickstart",
+                f"{gateway_cli._launchd_domain()}/{gateway_cli.get_launchd_label()}",
+            ]
+        ]
+        assert "already installed" in capsys.readouterr().out.lower()
+
+    def test_force_install_explicitly_overwrites_external_launchd_definition(
+        self, tmp_path, monkeypatch
+    ):
+        plist_path = tmp_path / "ai.hermes.gateway.plist"
+        plist_path.write_text(
+            "<plist><dict>"
+            f"<key>Label</key><string>{gateway_cli.get_launchd_label()}</string>"
+            "<key>HermesManagedExternally</key><true/>"
+            "</dict></plist>",
+            encoding="utf-8",
+        )
+        replacement = "<plist><dict><key>Replacement</key><true/></dict></plist>"
+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(gateway_cli, "generate_launchd_plist", lambda: replacement)
+        monkeypatch.setattr(
+            gateway_cli, "_refuse_temp_home_service_write", lambda definition, kind: False
+        )
+        monkeypatch.setattr(
+            gateway_cli.subprocess,
+            "run",
+            lambda *args, **kwargs: SimpleNamespace(returncode=0, stdout="", stderr=""),
+        )
+
+        gateway_cli.launchd_install(force=True)
+
+        assert plist_path.read_text(encoding="utf-8") == replacement
