diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index 6e298ea..59feb1c 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -8,6 +8,7 @@ import asyncio
 import json
 import logging
 import os
+import plistlib
 import shlex
 import shutil
 import signal
@@ -4054,13 +4055,47 @@ def generate_launchd_plist() -> str:
 """
 
 
+_LAUNCHD_EXTERNAL_MANAGEMENT_KEY = "HermesManagedExternally"
+
+
+def launchd_plist_is_externally_managed() -> bool:
+    """Return whether the installed plist explicitly opts out of Hermes rewrites.
+
+    Custom launchd definitions may wrap Hermes with a credential bootstrap or
+    another operator-owned supervisor.  Only a real plist boolean opts out;
+    malformed files and string-like values fail closed into the normal strict
+    comparison and repair path.
+    """
+    plist_path = get_launchd_plist_path()
+    if not plist_path.is_file():
+        return False
+    try:
+        with plist_path.open("rb") as handle:
+            installed = plistlib.load(handle)
+    # plistlib's typed XML decoders raise inconsistent built-ins for malformed
+    # values (for example ValueError for integers and AttributeError for dates).
+    # This read-only classifier must fail closed regardless of parser detail.
+    except Exception:
+        return False
+    return (
+        isinstance(installed, dict)
+        and installed.get(_LAUNCHD_EXTERNAL_MANAGEMENT_KEY) is True
+        and installed.get("Label") == get_launchd_label()
+    )
+
+
 def launchd_plist_is_current() -> bool:
     """Check if the installed launchd plist matches the currently generated one."""
     plist_path = get_launchd_plist_path()
     if not plist_path.exists():
         return False
+    if launchd_plist_is_externally_managed():
+        return True
 
-    installed = plist_path.read_text(encoding="utf-8")
+    try:
+        installed = plist_path.read_text(encoding="utf-8")
+    except (OSError, UnicodeError):
+        return False
     expected = generate_launchd_plist()
     return _normalize_launchd_plist_for_comparison(
         installed
@@ -4545,7 +4580,9 @@ def launchd_status(deep: bool = False):
 
     # ── Report ──
     print(f"Launchd plist: {plist_path}")
-    if launchd_plist_is_current():
+    if launchd_plist_is_externally_managed():
+        print("✓ Service definition is externally managed; Hermes will not rewrite it")
+    elif launchd_plist_is_current():
         print("✓ Service definition matches the current Hermes install")
     else:
         print("⚠ Service definition is stale relative to the current Hermes install")
