+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(gateway_cli, "generate_launchd_plist", lambda: "different")
+
+        assert gateway_cli.launchd_plist_is_current() is False
+
+    @pytest.mark.parametrize(
+        "content",
+        [
+            (
+                "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+                "<plist version=\"1.0\"><dict>"
+                "<key>HermesManagedExternally</key><true/>"
+                "<key>Broken</key><integer>bad</integer>"
+                "</dict></plist>"
+            ).encode(),
+            (
+                "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+                "<plist version=\"1.0\"><dict>"
+                "<key>HermesManagedExternally</key><true/>"
+                "<key>Broken</key><date>not-a-date</date>"
+                "</dict></plist>"
+            ).encode(),
+            b"\xff\xfe\x00not-a-plist",
+        ],
+    )
+    def test_malformed_launchd_plist_fails_closed_without_crashing(
+        self, content, tmp_path, monkeypatch
+    ):
+        plist_path = tmp_path / "ai.hermes.gateway.plist"
+        plist_path.write_bytes(content)
+        monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+        monkeypatch.setattr(gateway_cli, "generate_launchd_plist", lambda: "different")
+
+        assert gateway_cli.launchd_plist_is_current() is False
