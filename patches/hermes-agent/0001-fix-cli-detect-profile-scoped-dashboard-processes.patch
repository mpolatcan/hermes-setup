+def _hermes_backend_command_kind(command: str) -> str | None:
+    """Return ``dashboard``/``serve`` for a structurally valid Hermes command.
+
+    Process-table rows contain the full argv rendered as text.  Tokenize that
+    text and recognize only supported Hermes launch forms instead of matching
+    command substrings that may occur inside audit scripts or chat prompts.
+    Global profile selection is valid before the subcommand.
+    """
+    try:
+        tokens = shlex.split(command, posix=sys.platform != "win32")
+    except ValueError:
+        return None
+    if not tokens:
+        return None
+
+    def _normalized_token(token: str) -> str:
+        if len(token) >= 2 and token[0] == token[-1] and token[0] in {"'", '"'}:
+            token = token[1:-1]
+        return token.replace("\\", "/")
+
+    executable = _normalized_token(tokens[0]).rsplit("/", 1)[-1].lower()
+    args_start: int | None = None
+    if executable in {"hermes", "hermes.exe"}:
+        args_start = 1
+    elif re.fullmatch(r"pythonw?(?:\d+(?:\.\d+)*)?(?:\.exe)?", executable):
+        if (
+            len(tokens) >= 3
+            and _normalized_token(tokens[1]) == "-m"
+            and _normalized_token(tokens[2]) == "hermes_cli.main"
+        ):
+            args_start = 3
+        elif len(tokens) >= 2:
+            script = _normalized_token(tokens[1])
+            script_name = script.rsplit("/", 1)[-1].lower()
+            if (
+                script == "hermes_cli/main.py"
+                or script.endswith("/hermes_cli/main.py")
+                or script_name == "hermes"
+            ):
+                args_start = 2
+
+    if args_start is None:
+        return None
+
+    args = tokens[args_start:]
+    index = 0
+    while index < len(args):
+        token = args[index]
+        if token in {"-p", "--profile"}:
+            if index + 1 >= len(args):
+                return None
+            index += 2
+            continue
+        if token.startswith("--profile="):
+            index += 1
+            continue
+        break
+
+    if index < len(args) and args[index] in {"dashboard", "serve"}:
+        return args[index]
+    return None
+
+
 def _find_stale_dashboard_pids(
     *,
     exclude_pids: set[int] | None = None,
+    include_serve: bool = True,
 ) -> list[int]:
     """Return PIDs of ``hermes dashboard`` processes other than ourselves.
 
@@ -6514,17 +6578,6 @@ def _find_stale_dashboard_pids(
 
