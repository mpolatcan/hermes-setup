--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -6089,17 +6089,102 @@ def _find_stale_dashboard_pids(
 
     Returns an empty list on any scan error (missing ps/wmic, timeout, etc.).
     """
-    patterns = [
-        "hermes dashboard",
-        "hermes_cli.main dashboard",
-        "hermes_cli/main.py dashboard",
-        # The headless backend (`hermes serve`) is the same long-lived server
-        # under a different command name — the desktop app spawns it. Reap it
-        # on update for the same frontend/backend-mismatch reason.
-        "hermes serve",
-        "hermes_cli.main serve",
-        "hermes_cli/main.py serve",
-    ]
+    def _matches_dashboard_command(command: str) -> bool:
+        """Return whether *command* is an exact dashboard/serve launch."""
+        try:
+            tokens = shlex.split(command, posix=sys.platform != "win32")
+        except ValueError:
+            # A malformed command line cannot be validated safely.
+            return False
+
+        if sys.platform == "win32":
+            # With posix=False, shlex preserves the quotes around each Windows
+            # argv token. Strip only a complete matching pair; malformed
+            # quoting has already raised ValueError above.
+            tokens = [
+                token[1:-1]
+                if len(token) >= 2
+                and token[0] == token[-1]
+                and token[0] in {'"', "'"}
+                else token
+                for token in tokens
+            ]
+
+        if not tokens:
+            return False
+        if any(token in {"--status", "--stop"} for token in tokens):
+            return False
+
+        def _basename(token: str) -> str:
+            return token.replace("\\", "/").rsplit("/", 1)[-1].lower()
+
+        def _is_python_executable(token: str) -> bool:
+            name = _basename(token)
+            if name.endswith(".exe"):
+                name = name[:-4]
+            for prefix in ("python", "pythonw"):
+                if name == prefix:
+                    return True
+                if not name.startswith(prefix):
+                    continue
+                suffix = name[len(prefix) :]
+                if suffix and all(part.isdigit() for part in suffix.split(".")):
+                    return True
+            return False
+
+        def _is_main_script(token: str) -> bool:
+            path = token.replace("\\", "/").lower()
+            return path == "hermes_cli/main.py" or path.endswith(
+                "/hermes_cli/main.py"
+            )
+
+        def _is_console_entrypoint_script(token: str) -> bool:
+            """Recognize the scripts generated for the ``hermes`` entrypoint."""
+            return _basename(token) in {"hermes", "hermes-script.py"}
+
+        executable = _basename(tokens[0])
+        if executable in {"hermes", "hermes.exe"}:
+            command_index = 1
+        elif _is_python_executable(tokens[0]):
+            if tokens[1:3] == ["-m", "hermes_cli.main"]:
+                command_index = 3
+            elif len(tokens) > 1 and (
+                _is_main_script(tokens[1])
+                or _is_console_entrypoint_script(tokens[1])
+            ):
+                command_index = 2
+            else:
+                return False
+        elif _is_main_script(tokens[0]):
+            command_index = 1
+        else:
+            return False
+
+        while command_index < len(tokens):
+            token = tokens[command_index]
+            if token in {"-p", "--profile"}:
+                if command_index + 1 >= len(tokens):
+                    return False
+                command_index += 2
+            elif token.startswith("--profile=") and token != "--profile=":
+                command_index += 1
+            else:
+                break
+
+        if (
+            command_index >= len(tokens)
+            or tokens[command_index] not in {"dashboard", "serve"}
+        ):
+            return False
+
+        server_command = tokens[command_index]
+        server_args = tokens[command_index + 1 :]
+        if any(token in {"--help", "-h"} for token in server_args):
+            return False
+        if server_command == "dashboard" and server_args[:1] == ["register"]:
+            return False
+        return True
+
     self_pid = os.getpid()
     dashboard_pids: list[int] = []
 
@@ -6136,7 +6221,7 @@ def _find_stale_dashboard_pids(
                 elif line.startswith("ProcessId="):
                     pid_str = line[len("ProcessId=") :]
                     if (
-                        any(p in current_cmd for p in patterns)
+                        _matches_dashboard_command(current_cmd)
                         and int(pid_str) != self_pid
                     ):
                         try:
@@ -6169,7 +6254,7 @@ def _find_stale_dashboard_pids(
                     except ValueError:
                         continue
                     command = parts[1]
-                    if any(p in command for p in patterns) and pid != self_pid:
+                    if _matches_dashboard_command(command) and pid != self_pid:
                         dashboard_pids.append(pid)
     except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
         return []
