+class TestWindowsDashboardDetection:
+    """Windows command lines are parsed as argv, including quoted tokens."""
+
+    @staticmethod
+    def _wmic_output(command: str, pid: int = 12345) -> str:
+        return f"CommandLine={command}\nProcessId={pid}\n"
+
+    @pytest.mark.parametrize(
+        "command",
+        [
+            '"C:\\Program Files\\Hermes\\hermes.exe" "-p" "work" "dashboard"',
+            '"C:\\Program Files\\Hermes\\hermes.exe" "--profile" "work" "serve"',
+            '"C:\\Program Files\\Hermes\\hermes.exe" "--profile=work" "dashboard"',
+            '"python.exe" "-m" "hermes_cli.main" "--profile=work" "serve"',
+            '"python.exe" "C:\\src\\hermes_cli\\main.py" "-p" "work" "dashboard"',
+            '"python.exe" "C:\\venv\\Scripts\\hermes-script.py" "dashboard"',
+            '"python.exe" "C:\\venv\\Scripts\\hermes-script.py" "--profile" "work" "serve"',
+        ],
+    )
+    def test_matches_quoted_supported_launch_forms(
+        self, monkeypatch, command
+    ):
+        monkeypatch.setattr(sys, "platform", "win32")
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=self._wmic_output(command),
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == [12345]
+
+    @pytest.mark.parametrize(
+        "command",
+        [
+            '"hermes.exe" "dashboard" "--status"',
+            '"hermes.exe" "dashboard" "--stop"',
+            '"hermes.exe" "dashboard" "register"',
+            '"hermes.exe" "dashboard" "--help"',
+            '"hermes.exe" "dashboard" "-h"',
+            '"hermes.exe" "serve" "--help"',
+            '"hermes.exe" "serve" "-h"',
+            '"python.exe" "C:\\venv\\Scripts\\hermes-script.py" '
+            '"--profile=work" "dashboard" "register"',
+        ],
+    )
+    def test_rejects_quoted_control_and_non_server_invocations(
+        self, monkeypatch, command
+    ):
+        monkeypatch.setattr(sys, "platform", "win32")
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=self._wmic_output(command),
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == []
+
+    @pytest.mark.parametrize(
+        "command",
+        [
+            '"cmd.exe" "/c" "hermes.exe" "dashboard"',
+            '"python.exe" "worker.py" "hermes.exe" "serve"',
+            '"hermes-helper.exe" "dashboard"',
+            '"hermes.exe" "dashboard-worker"',
+        ],
+    )
+    def test_rejects_unrelated_windows_argv(self, monkeypatch, command):
+        monkeypatch.setattr(sys, "platform", "win32")
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=self._wmic_output(command),
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == []
+
+    def test_rejects_malformed_windows_quotes(self, monkeypatch):
+        monkeypatch.setattr(sys, "platform", "win32")
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=self._wmic_output('"hermes.exe" "dashboard'),
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == []
