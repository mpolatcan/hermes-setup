+    def test_profile_scoped_dashboard_commands_match(self):
+        """Global profile flags may appear before the dashboard subcommand."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout="\n".join([
+                    _ps_line(12345, "hermes -p general dashboard --port 9119"),
+                    _ps_line(12346, "python3 -m hermes_cli.main --profile default dashboard --port 9120"),
+                ]) + "\n",
+                stderr="",
+            )
+            assert sorted(_find_stale_dashboard_pids()) == [12345, 12346]
+
+    def test_status_mode_excludes_serve_backend(self):
+        """Dashboard status must not report a headless Desktop/serve backend."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout="\n".join([
+                    _ps_line(12345, "python3 -m hermes_cli.main -p default dashboard --port 9119"),
+                    _ps_line(22222, "python3 -m hermes_cli.main serve --port 0"),
+                ]) + "\n",
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids(include_serve=False) == [12345]
+
+    def test_update_mode_keeps_matching_serve_backend(self):
+        """Update cleanup retains the existing Desktop-backend protection."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=_ps_line(22222, "python3 -m hermes_cli.main serve --port 0") + "\n",
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == [22222]
+
+    def test_embedded_command_text_is_not_a_process_match(self):
+        """Code/audit processes that merely quote a Hermes command are ignored."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout=_ps_line(
+                    33333,
+                    "python3 -c 'subprocess.run([\"hermes\", \"dashboard\", \"--status\"])'",
+                ) + "\n",
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == []
+
+    def test_unrelated_process_with_separate_hermes_args_is_not_matched(self):
+        """Only a launcher prefix may introduce a Hermes backend command."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout="\n".join([
+                    _ps_line(33333, "python3 audit.py hermes dashboard"),
+                    _ps_line(33334, 'echo "hermes" dashboard'),
+                ]) + "\n",
+                stderr="",
+            )
+            assert _find_stale_dashboard_pids() == []
+
+    def test_python_launched_posix_shim_is_supported(self):
+        """The official POSIX shim execs Python with the shim path as argv[1]."""
+        with patch("subprocess.run") as mock_run:
+            mock_run.return_value = MagicMock(
+                returncode=0,
+                stdout="\n".join([
+                    _ps_line(12345, "python /Users/example/.local/bin/hermes -p general dashboard"),
+                    _ps_line(12346, "python3 /opt/hermes serve --port 0"),
+                ]) + "\n",
+                stderr="",
+            )
+            assert sorted(_find_stale_dashboard_pids()) == [12345, 12346]
+
+    def test_blank_command_line_is_ignored(self):
+        """WMIC may report processes with an empty CommandLine value."""
+        assert _hermes_backend_command_kind("") is None
+        assert _hermes_backend_command_kind("   ") is None
+
+    def test_windows_quoted_launch_paths_are_supported(self):
+        """Windows process-table quoting must not hide valid launchers."""
+        with patch("hermes_cli.main.sys.platform", "win32"):
+            assert _hermes_backend_command_kind(
+                '"C:\\Program Files\\Hermes\\hermes.exe" -p general dashboard'
+            ) == "dashboard"
+            assert _hermes_backend_command_kind(
+                '"C:\\Program Files\\Python\\python.exe" -m hermes_cli.main serve'
+            ) == "serve"
+            assert _hermes_backend_command_kind(
+                'python "C:\\Program Files\\Hermes\\hermes_cli\\main.py" dashboard'
+            ) == "dashboard"
+
