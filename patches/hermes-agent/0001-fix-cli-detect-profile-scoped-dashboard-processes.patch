                         dashboard_pids.append(pid)
     except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
         return []
@@ -13694,7 +13755,7 @@ def _report_dashboard_status() -> int:
     runs in a short-lived CLI process that never matches the pattern,
