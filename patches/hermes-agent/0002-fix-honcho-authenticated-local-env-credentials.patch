From 079e5d98872b284457c63dd5b2660bfa9f3129ce Mon Sep 17 00:00:00 2001
From: Mutlu Polatcan <mutlupolatcan@gmail.com>
Date: Sun, 26 Jul 2026 21:01:25 +0300
Subject: [PATCH] fix(honcho): allow authenticated local env credentials

---
 plugins/memory/honcho/client.py    | 11 ++++++++++-
 tests/honcho_plugin/test_client.py | 31 ++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/plugins/memory/honcho/client.py b/plugins/memory/honcho/client.py
index cc1da55..11ad179 100644
--- a/plugins/memory/honcho/client.py
+++ b/plugins/memory/honcho/client.py
@@ -1071,7 +1071,16 @@ def get_honcho_client(config: HonchoClientConfig | None = None) -> Honcho:
             _raw = config.raw or {}
             _host_block = (_raw.get("hosts") or {}).get(config.host, {})
             _host_has_key = bool(_host_block.get("apiKey"))
-            effective_api_key = config.api_key if _host_has_key else "local"
+            _local_auth_required = bool(
+                _host_block.get(
+                    "authRequired", _raw.get("authRequired", False)
+                )
+            )
+            effective_api_key = (
+                config.api_key
+                if _host_has_key or _local_auth_required
+                else "local"
+            )
         else:
             effective_api_key = config.api_key
 
diff --git a/tests/honcho_plugin/test_client.py b/tests/honcho_plugin/test_client.py
index 2f51be5..2adaabf 100644
--- a/tests/honcho_plugin/test_client.py
+++ b/tests/honcho_plugin/test_client.py
@@ -1197,6 +1197,37 @@ class TestGetHonchoClientBaseUrlDoublePrefixFix:
         assert mock_honcho.call_args.kwargs["api_key"] == "local"
         assert mock_honcho.call_args.kwargs["base_url"] == "http://192.168.2.112:8000"
 
+    def test_local_auth_required_preserves_environment_api_key(self, tmp_path):
+        """Authenticated local servers can opt into an env-owned JWT without
+        persisting that JWT in honcho.json."""
+        config_file = tmp_path / "honcho.json"
+        config_file.write_text(json.dumps({
+            "baseUrl": "http://localhost:8000",
+            "workspace": "polatcan-gaming",
+            "hosts": {
+                "hermes_general": {
+                    "workspace": "polatcan-gaming",
+                    "aiPeer": "general",
+                    "authRequired": True,
+                },
+            },
+        }))
+
+        with patch.dict(os.environ, {"HONCHO_API_KEY": "derived-jwt"}, clear=True), \
+             patch("hermes_cli.profiles.get_active_profile_name", return_value="general"), \
+             patch("plugins.memory.honcho.client.resolve_config_path", return_value=config_file):
+            cfg = HonchoClientConfig.from_global_config(config_path=config_file)
+
+        fake_honcho = MagicMock(name="Honcho")
+        mock_honcho = MagicMock(return_value=fake_honcho)
+        fake_honcho_module = types.SimpleNamespace(Honcho=mock_honcho)
+        with patch.dict(sys.modules, {"honcho": fake_honcho_module}), \
+             patch("hermes_cli.config.load_config", return_value={}):
+            get_honcho_client(cfg)
+
+        mock_honcho.assert_called_once()
+        assert mock_honcho.call_args.kwargs["api_key"] == "derived-jwt"
+
     def test_lan_default_host_explicit_host_key_preserved(self, tmp_path):
         """A host-block local JWT still wins for LAN/VPN local URLs."""
         config_file = tmp_path / "honcho.json"
