diff --git a/gateway/turn_context.py b/gateway/turn_context.py
index ac727e2b..2d83ee00 100644
--- a/gateway/turn_context.py
+++ b/gateway/turn_context.py
@@ -25,6 +25,7 @@ Field notes:
 
 from __future__ import annotations
 
+import threading
 from dataclasses import dataclass, field
 from typing import Any, Callable, List, Optional
 
@@ -50,6 +51,13 @@ class TurnContext:
     # --- mutable single-element containers (shared with the outer body) --
     last_progress_msg: list = field(default_factory=lambda: [None])
     last_tool: list = field(default_factory=lambda: [None])
+    # Safe, user-facing summary for periodic heartbeats.  Keep this separate
+    # from AIAgent.last_activity_desc: transport updates such as "receiving
+    # stream response" must not erase the last meaningful work step.
+    heartbeat_activity: list = field(default_factory=lambda: [None])
+    heartbeat_active_tools: list = field(default_factory=list)
+    heartbeat_parallel: list = field(default_factory=lambda: [False])
+    heartbeat_lock: Any = field(default_factory=threading.Lock)
     last_was_terminal_block: list = field(default_factory=lambda: [False])
     repeat_count: list = field(default_factory=lambda: [0])
     long_tool_hint_fired: list = field(default_factory=lambda: [False])
@@ -97,6 +105,7 @@ class TurnContext:
     log_mode_enabled: bool = False
     interim_assistant_messages_enabled: bool = False
     needs_progress_queue: bool = False
+    heartbeat_progress_enabled: bool = False
 
     # --- lazy-imported callables captured from the outer body -------------
     AIAgent: Any = None
diff --git a/tests/gateway/test_meaningful_heartbeat_progress.py b/tests/gateway/test_meaningful_heartbeat_progress.py
new file mode 100644
index 00000000..dc9c0cfc
--- /dev/null
+++ b/tests/gateway/test_meaningful_heartbeat_progress.py
@@ -0,0 +1,175 @@
+from types import SimpleNamespace
+
+from gateway.run import (
+    TurnRunner,
+    _build_long_running_status_detail,
+    _safe_heartbeat_tool_activity,
+    _should_install_progress_callback,
+)
+from gateway.turn_context import TurnContext
+
+
+def test_long_running_heartbeat_alone_installs_progress_callback() -> None:
+    ctx = TurnContext(
+        needs_progress_queue=False,
+        log_mode_enabled=False,
+        _live_status_adapter=None,
+        heartbeat_progress_enabled=True,
+    )
+
+    assert _should_install_progress_callback(ctx) is True
+
+
+def test_terminal_activity_classifies_tests_without_exposing_command() -> None:
+    command = "pytest tests/gateway -q --token super-secret"
+
+    active, completed = _safe_heartbeat_tool_activity(
+        "terminal", {"command": command}
+    )
+
+    assert active == "Running tests"
+    assert completed == "Ran tests; reviewing results"
+    assert "super-secret" not in active + completed
+    assert command not in active + completed
+
+
+def test_linear_activity_never_interpolates_raw_arguments() -> None:
+    active, completed = _safe_heartbeat_tool_activity(
+        "linear_get_issue",
+        {"id": "OPS-69", "unsafe": "credential-value"},
+    )
+
+    assert active == "Reading Linear work state"
+    assert completed == "Read Linear work state; planning next step"
+    assert "OPS-69" not in active + completed
+    assert "credential-value" not in active + completed
+
+
+def test_unknown_tool_name_is_not_rendered() -> None:
+    active, completed = _safe_heartbeat_tool_activity(
+        "plugin_secret_identifier", {"token": "credential-value"}
+    )
+
+    assert active == "Using an integration"
+    assert completed == "Finished an integration; planning next step"
+    assert "secret" not in (active + completed).casefold()
+    assert "credential-value" not in active + completed
+
+
+def test_progress_callback_retains_last_meaningful_completed_step_when_chat_progress_is_off() -> None:
+    ctx = TurnContext(
+        source=SimpleNamespace(chat_id="session-1"),
+        _run_still_current=lambda: True,
+        progress_queue=None,
+        tool_progress_enabled=False,
+    )
+    runner = TurnRunner(SimpleNamespace(), ctx)
+
+    runner.progress_callback(
+        "tool.started",
+        "terminal",
+        preview="unsafe preview",
+        args={"command": "op item get Shared --format json"},
+    )
+    assert ctx.heartbeat_activity[0] == "Checking 1Password access"
+
+    runner.progress_callback("tool.completed", "terminal", duration=1.2)
+    assert ctx.heartbeat_activity[0] == (
+        "Checked 1Password access; reviewing result"
+    )
+
+
+def test_completion_only_event_still_records_safe_completed_step() -> None:
+    ctx = TurnContext(
+        source=SimpleNamespace(chat_id="session-1"),
+        _run_still_current=lambda: True,
+        progress_queue=None,
+        tool_progress_enabled=False,
+    )
+    runner = TurnRunner(SimpleNamespace(), ctx)
+
+    runner.progress_callback("tool.completed", "linear_get_issue", duration=0.1)
+
+    assert ctx.heartbeat_activity[0] == (
+        "Read Linear work state; planning next step"
+    )
+
+
+def test_parallel_tools_use_fixed_aggregate_until_all_complete() -> None:
+    ctx = TurnContext(
+        source=SimpleNamespace(chat_id="session-1"),
+        _run_still_current=lambda: True,
+        progress_queue=None,
+        tool_progress_enabled=False,
+    )
+    runner = TurnRunner(SimpleNamespace(), ctx)
+
+    runner.progress_callback(
+        "tool.started", "terminal", args={"command": "op item get Shared"}
+    )
+    runner.progress_callback("tool.started", "read_file", args={"path": "secret.txt"})
+    assert ctx.heartbeat_activity[0] == "Running multiple work steps"
+
+    runner.progress_callback("tool.completed", "terminal")
+    assert ctx.heartbeat_activity[0] == "Running multiple work steps"
+
+    runner.progress_callback("tool.completed", "read_file")
+    assert ctx.heartbeat_activity[0] == (
+        "Completed multiple work steps; reviewing results"
+    )
+
+
+def test_completion_only_event_does_not_erase_an_overlapping_active_tool() -> None:
+    ctx = TurnContext(
+        source=SimpleNamespace(chat_id="session-1"),
+        _run_still_current=lambda: True,
+        progress_queue=None,
+        tool_progress_enabled=False,
+    )
+    runner = TurnRunner(SimpleNamespace(), ctx)
+
+    runner.progress_callback(
+        "tool.started", "terminal", args={"command": "pytest -q"}
+    )
+    runner.progress_callback("tool.completed", "linear_get_issue")
+
+    assert ctx.heartbeat_activity[0] == "Running multiple work steps"
+
+    runner.progress_callback("tool.completed", "terminal")
+    assert ctx.heartbeat_activity[0] == (
+        "Completed multiple work steps; reviewing results"
+    )
+
+
+def test_heartbeat_prefers_safe_work_context_over_stream_transport_state() -> None:
+    detail = _build_long_running_status_detail(
+        {
+            "api_call_count": 22,
+            "max_iterations": 90,
+            "current_tool": None,
+            "last_activity_desc": "receiving stream response",
+        },
+        safe_activity="Checked 1Password access; reviewing result",
+        include_iteration=True,
+    )
+
+    assert detail == (
+        " — Checked 1Password access; reviewing result · iteration 22/90"
+    )
+    assert "receiving stream response" not in detail
+
+
+def test_heartbeat_never_falls_back_to_unrestricted_activity_description() -> None:
+    detail = _build_long_running_status_detail(
+        {
+            "api_call_count": 4,
+            "max_iterations": 90,
+            "current_tool": None,
+            "last_activity_desc": "token=credential-value from plugin output",
+        },
+        safe_activity=None,
+        include_iteration=True,
+    )
+
+    assert detail == " — iteration 4/90"
+    assert "credential-value" not in detail
