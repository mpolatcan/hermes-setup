diff --git a/gateway/run.py b/gateway/run.py
index 75f424ef..392dd723 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -468,6 +468,48 @@ def _non_conversational_metadata(
     return merged
 
 
+async def _send_long_running_notification(
+    adapter: Any,
+    *,
+    chat_id: str,
+    text: str,
+    heartbeat_message_id: Optional[str],
+    metadata: Optional[Dict[str, Any]],
+) -> tuple[Optional[str], bool]:
+    """Send or edit a transient heartbeat only on editable surfaces.
+
+    Append-only adapters map every send to a terminal activity. Sending a
+    periodic heartbeat there would prematurely complete the remote session,
+    so capability-gate the entire transient delivery path.
+    """
+    if not getattr(adapter, "SUPPORTS_MESSAGE_EDITING", True):
+        return heartbeat_message_id, False
+
+    if heartbeat_message_id:
+        try:
+            edit_result = await adapter.edit_message(
+                chat_id,
+                heartbeat_message_id,
+                text,
+            )
+        except Exception as exc:
+            logger.debug("Heartbeat edit failed: %s", exc)
+            edit_result = None
+        if edit_result and getattr(edit_result, "success", False):
+            return heartbeat_message_id, False
+
+    send_result = await adapter.send(chat_id, text, metadata=metadata)
+    send_succeeded = bool(
+        send_result and getattr(send_result, "success", False)
+    )
+    new_message_id = (
+        getattr(send_result, "message_id", None) if send_succeeded else None
+    )
+    if new_message_id:
+        return str(new_message_id), True
+    return heartbeat_message_id, False
+
+
 def _seed_hygiene_system_prompt(
     agent: Any,
     session_row: Optional[Dict[str, Any]],
@@ -25555,29 +25597,24 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
                     else f"⏳ Working — {_elapsed_mins} min{_status_detail}"
