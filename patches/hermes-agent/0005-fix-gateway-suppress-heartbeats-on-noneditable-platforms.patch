diff --git a/gateway/run.py b/gateway/run.py
index aac6a19..7aa0805 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -323,6 +323,47 @@ def _non_conversational_metadata(
     return merged
 
 
+async def _send_long_running_notification(
+    adapter: Any,
+    *,
+    chat_id: str,
+    text: str,
+    heartbeat_message_id: Optional[str],
+    metadata: Optional[Dict[str, Any]],
+) -> tuple[Optional[str], bool]:
+    """Send or edit a transient heartbeat only on editable surfaces.
+
+    Append-only adapters map every send to a terminal activity.  Sending a
+    periodic heartbeat there would prematurely complete the remote session,
+    so capability-gate the entire transient delivery path.
+    """
+    if not getattr(adapter, "SUPPORTS_MESSAGE_EDITING", True):
+        return heartbeat_message_id, False
+
+    result = None
+    if heartbeat_message_id:
+        try:
+            result = await adapter.edit_message(
+                chat_id,
+                heartbeat_message_id,
+                text,
+            )
+        except Exception as exc:
+            logger.debug("Heartbeat edit failed: %s", exc)
+            result = None
+
+    created_new = False
+    if not (result and getattr(result, "success", False)):
+        result = await adapter.send(chat_id, text, metadata=metadata)
+        created_new = bool(result and getattr(result, "success", False))
+
+    succeeded = bool(result and getattr(result, "success", False))
+    message_id = getattr(result, "message_id", None) if succeeded else None
+    if message_id:
+        return str(message_id), created_new
+    return heartbeat_message_id, created_new
+
+
 def _is_transient_network_error(exc: BaseException) -> bool:
     """Return True for transient network errors safe to log + swallow.
 
