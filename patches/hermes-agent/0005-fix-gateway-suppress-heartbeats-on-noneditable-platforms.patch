diff --git a/tests/gateway/test_long_running_notifications.py b/tests/gateway/test_long_running_notifications.py
new file mode 100644
index 0000000..28a5fc4
--- /dev/null
+++ b/tests/gateway/test_long_running_notifications.py
@@ -0,0 +1,70 @@
+"""Regression coverage for transient long-running gateway notifications."""
+
+from __future__ import annotations
+
+import asyncio
+
+from gateway.run import _send_long_running_notification
+
+
+class _Result:
+    def __init__(self, *, success: bool, message_id: str | None = None):
+        self.success = success
+        self.message_id = message_id
+
+
+class _NonEditableAdapter:
+    SUPPORTS_MESSAGE_EDITING = False
+
+    def __init__(self) -> None:
+        self.edit_calls = 0
+        self.send_calls = 0
+
+    async def edit_message(self, *args, **kwargs):
+        self.edit_calls += 1
+        return _Result(success=True, message_id="edited")
+
+    async def send(self, *args, **kwargs):
+        self.send_calls += 1
+        return _Result(success=True, message_id="sent")
+
+
+class _FailedSendAdapter:
+    SUPPORTS_MESSAGE_EDITING = True
+
+    async def send(self, *args, **kwargs):
+        return _Result(success=False, message_id="partial-send")
+
+
+def test_long_running_heartbeat_is_suppressed_on_noneditable_adapter() -> None:
+    adapter = _NonEditableAdapter()
+
+    message_id, delivered = asyncio.run(
+        _send_long_running_notification(
+            adapter,
+            chat_id="session-uuid",
+            text="working",
+            heartbeat_message_id=None,
+            metadata={"non_conversational": True},
+        )
+    )
+
+    assert message_id is None
+    assert delivered is False
+    assert adapter.edit_calls == 0
+    assert adapter.send_calls == 0
+
+
+def test_failed_heartbeat_send_does_not_adopt_partial_message_id() -> None:
+    message_id, delivered = asyncio.run(
+        _send_long_running_notification(
+            _FailedSendAdapter(),
+            chat_id="session-uuid",
+            text="working",
+            heartbeat_message_id=None,
+            metadata=None,
+        )
+    )
+
+    assert message_id is None
+    assert delivered is False
