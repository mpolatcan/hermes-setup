diff --git a/cron/scheduler.py b/cron/scheduler.py
index b6b89010..5d9cde8f 100644
--- a/cron/scheduler.py
+++ b/cron/scheduler.py
@@ -1320,20 +1320,23 @@ def _resolve_single_delivery_target(job: dict, deliver_value: str) -> Optional[d
         else:
             chat_id, thread_id = rest, None
 
-        # Resolve human-friendly labels like "Alice (dm)" to real IDs.
-        try:
-            from gateway.channel_directory import resolve_channel_name
-            resolved = resolve_channel_name(platform_key, chat_id)
-            if resolved:
-                parsed_chat_id, parsed_thread_id, resolved_is_explicit = _parse_target_ref(platform_key, resolved)
-                if resolved_is_explicit:
-                    chat_id = parsed_chat_id
-                    if parsed_thread_id is not None:
-                        thread_id = parsed_thread_id
-                else:
-                    chat_id = resolved
-        except Exception:
-            pass
+        # Resolve only human-friendly labels. Explicit platform-native targets
+        # (including Linear AgentSession UUIDs) must never be remapped through
+        # a mutable directory entry.
+        if not is_explicit:
+            try:
+                from gateway.channel_directory import resolve_channel_name
+                resolved = resolve_channel_name(platform_key, str(chat_id))
+                if resolved:
+                    parsed_chat_id, parsed_thread_id, resolved_is_explicit = _parse_target_ref(platform_key, resolved)
+                    if resolved_is_explicit:
+                        chat_id = parsed_chat_id
+                        if parsed_thread_id is not None:
+                            thread_id = parsed_thread_id
+                    else:
+                        chat_id = resolved
+            except Exception:
+                pass
 
         if (
             thread_id is None
diff --git a/tests/cron/test_scheduler.py b/tests/cron/test_scheduler.py
index 357614a2..6db11c2f 100644
--- a/tests/cron/test_scheduler.py
+++ b/tests/cron/test_scheduler.py
@@ -167,6 +167,22 @@ class TestResolveDeliveryTarget:
             "thread_id": "17",
         }
 
+    def test_explicit_linear_session_uuid_bypasses_channel_directory(self):
+        session_id = "2f31d7a4-995c-4df4-a196-0123456789ab"
+        job = {"deliver": f"linear:{session_id}"}
+        with patch(
+            "gateway.channel_directory.resolve_channel_name",
+            side_effect=AssertionError("explicit UUID must not use directory resolution"),
+        ) as resolve_mock:
+            result = _resolve_delivery_target(job)
+
+        resolve_mock.assert_not_called()
+        assert result == {
+            "platform": "linear",
+            "chat_id": session_id,
+            "thread_id": None,
+        }
+
 
     def test_human_friendly_label_resolved_via_channel_directory(self):
         """deliver: 'whatsapp:Alice (dm)' resolves to the real JID."""
