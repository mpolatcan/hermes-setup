 def test_send_message_routes_whatsapp_group_jid_without_home_fallback() -> None:
     whatsapp_cfg = SimpleNamespace(enabled=True, token=None, extra={"api_url": "http://bridge"})
     config = SimpleNamespace(
@@ -64,3 +93,72 @@ def test_send_message_routes_whatsapp_group_jid_without_home_fallback() -> None:
         force_document=False,
     )
 
+
+def test_linear_uuid_bypasses_resolution_and_reaches_registered_sender() -> None:
+    session_id = "2f31d7a4-995c-4df4-a196-0123456789ab"
+    linear_cfg = SimpleNamespace(enabled=True, token=None, extra={})
+    get_home_channel = Mock(
+        side_effect=AssertionError("explicit UUID must not use home-channel fallback")
+    )
+    standalone_sender = AsyncMock(
+        return_value={"success": True, "message_id": "activity-1"}
+    )
+    entry = PlatformEntry(
+        name="linear",
+        label="Linear",
+        adapter_factory=lambda _config: None,
+        check_fn=lambda: True,
+        standalone_sender_fn=standalone_sender,
+    )
+    previous_entry = platform_registry._entries.get("linear")
+    previous_deferred = platform_registry._deferred.get("linear")
+    previous_platform = Platform._value2member_map_.get("linear")
+    previous_member = Platform._member_map_.get("LINEAR")
+    platform_registry.register(entry)
+    platforms = Mock()
+    platforms.get.return_value = linear_cfg
+    config = SimpleNamespace(platforms=platforms, get_home_channel=get_home_channel)
+
+    try:
+        with patch("gateway.config.load_gateway_config", return_value=config), \
+             patch("tools.interrupt.is_interrupted", return_value=False), \
+             patch(
+                 "gateway.channel_directory.resolve_channel_name",
+                 side_effect=AssertionError("explicit UUID must not use directory resolution"),
+             ), \
+             patch("gateway.run._gateway_runner_ref", return_value=None), \
+             patch.object(platform_registry, "get", return_value=entry), \
+             patch("model_tools._run_async", side_effect=_run_async_immediately), \
+             patch("gateway.mirror.mirror_to_session", return_value=True):
+            result = json.loads(
+                send_message_tool(
+                    {
+                        "action": "send",
+                        "target": f"linear:{session_id}",
+                        "message": "closure evidence",
+                    }
+                )
+            )
+    finally:
+        platform_registry.unregister("linear")
+        if previous_entry is not None:
+            platform_registry.register(previous_entry)
+        elif previous_deferred is not None:
+            platform_registry.register_deferred("linear", previous_deferred)
+        if previous_platform is None:
+            Platform._value2member_map_.pop("linear", None)
+        if previous_member is None:
+            Platform._member_map_.pop("LINEAR", None)
+
+    assert result["success"] is True
+    assert "note" not in result
+    get_home_channel.assert_not_called()
+    standalone_sender.assert_awaited_once_with(
+        linear_cfg,
+        session_id,
+        "closure evidence",
+        thread_id=None,
+        media_files=[],
+        force_document=False,
+    )
+
diff --git a/tools/send_message_tool.py b/tools/send_message_tool.py
index 2853c627..edba802e 100644
--- a/tools/send_message_tool.py
+++ b/tools/send_message_tool.py
@@ -56,6 +56,14 @@ _WHATSAPP_JID_RE = re.compile(
 # an explicit target for the email platform, not fall through to channel-name
 # resolution which has no way to resolve a raw address.
 _EMAIL_TARGET_RE = re.compile(r"^\s*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\s*$")
+# Linear AgentSession IDs are canonical UUIDs, not friendly channel names.
+# Keep this allowlist narrow: UUID-shaped aliases on unrelated platforms must
+# continue through directory resolution rather than becoming raw recipients.
+_UUID_TARGET_PLATFORMS = frozenset({"linear"})
+_UUID_TARGET_RE = re.compile(
+    r"^\s*[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-"
+    r"[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\s*$"
+)
 # Most platforms read their home channel from "<PLATFORM>_HOME_CHANNEL", but a
 # few diverge. Email reads EMAIL_HOME_ADDRESS (see gateway/config.py), so the
 # generic "<PLATFORM>_HOME_CHANNEL" hint would point users at a variable that is
@@ -609,6 +617,11 @@ def _parse_target_ref(platform_name: str, target_ref: str):
         # them off the channel directory (mirrors the react handler).
         if _PHOTON_DM_GUID_RE.fullmatch(target_ref.strip()):
             return target_ref.strip(), None, True
+    if (
+        platform_name in _UUID_TARGET_PLATFORMS
+        and _UUID_TARGET_RE.fullmatch(target_ref)
+    ):
+        return target_ref.strip(), None, True
     if target_ref.lstrip("-").isdigit():
         return target_ref, None, True
     # Matrix room IDs (start with !) and user IDs (start with @) are explicit
