+def test_linear_uuid_bypasses_resolution_and_reaches_registered_sender() -> None:
+    session_id = "2f31d7a4-995c-4df4-a196-0123456789ab"
+    linear_cfg = SimpleNamespace(enabled=True, token=None, extra={})
+    get_home_channel = Mock(
+        side_effect=AssertionError("explicit UUID must not use home-channel fallback")
+    )
+    standalone_sender = AsyncMock(
+        return_value={"success": True, "message_id": "activity-1"}
+    )
+    entry = PlatformEntry(
+        name="linear",
+        label="Linear",
+        adapter_factory=lambda _config: None,
+        check_fn=lambda: True,
+        standalone_sender_fn=standalone_sender,
+    )
+    platforms = Mock()
+    platforms.get.return_value = linear_cfg
+    config = SimpleNamespace(
+        platforms=platforms,
+        get_home_channel=get_home_channel,
+    )
+
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("tools.interrupt.is_interrupted", return_value=False), \
+         patch(
+             "gateway.channel_directory.resolve_channel_name",
+             side_effect=AssertionError("explicit UUID must not use directory resolution"),
+         ), \
+         patch("gateway.run._gateway_runner_ref", return_value=None), \
+         patch.object(platform_registry, "get", return_value=entry), \
+         patch("model_tools._run_async", side_effect=_run_async_immediately), \
+         patch("gateway.mirror.mirror_to_session", return_value=True):
+        result = json.loads(
+            send_message_tool(
+                {
+                    "action": "send",
+                    "target": f"linear:{session_id}",
+                    "message": "closure evidence",
+                }
+            )
+        )
+
+    assert result["success"] is True
+    assert "note" not in result
+    get_home_channel.assert_not_called()
+    standalone_sender.assert_awaited_once_with(
+        linear_cfg,
+        session_id,
+        "closure evidence",
+        thread_id=None,
+        media_files=[],
+        force_document=False,
+    )
